<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head') %>
<body>
<%- include('./partials/nav') %>
    <div class="blogs-content">    
        <h2>All Blogs</h2>

        <% if (blogs.length > 0)  { %>
            <% blogs.forEach(blog => { %>
                <div class="blog-item">
                    <a href="/blogs/<%= blog._id %>">
                        <h3><%= blog.title %></h3>
                        <p class="snippet"><%= blog.snippet %></p>
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <p>No blogs found.</p>
        <% } %>
    </div>
</body>
</html>